MARLIN_BASE_URL=http://127.0.0.1:8100
MARLIN_HTTP_TIMEOUT=5
LOG_LEVEL=INFO

# V0.2-A Agent reads process environment. Keep both sources offline by default.
PRINTDIAG_DEVICE_SOURCE=mock
PRINTDIAG_LLM_PROVIDER=mock
PRINTDIAG_ENABLE_LIVE_LLM=0
PRINTDIAG_LLM_BASE_URL=https://provider.example.invalid/v1
PRINTDIAG_LLM_API_KEY=
PRINTDIAG_LLM_MODEL=
PRINTDIAG_LLM_TIMEOUT=5
PRINTDIAG_LLM_MAX_TOKENS=1024
PRINTDIAG_LLM_MAX_ROUNDS=4
PRINTDIAG_LLM_TOKEN_PARAMETER=max_completion_tokens
